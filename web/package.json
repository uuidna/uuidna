      "@payloadcms/richtext-lexical@4.0.0-beta.7": "patches/@payloadcms__richtext-lexical@4.0.0-beta.7.patch"
    }
  },
  "packageManager": "pnpm@10.34.9",
  "description": "The uuidna.com site: Payload and Next.js on Cloudflare Workers (OpenNext), with D1, R2, Email Service and a ChatRoom Durable Object.",
