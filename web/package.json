{
  "name": "uuidna-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:preview-styles && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:preview-styles": "node ./src/scripts/generatePreviewStyles.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:llms": "payload run src/scripts/generateLLMs.ts",
    "seed": "payload run src/scripts/seedRecords.ts",
    "seed:check": "cross-env SEED_CHECK=1 payload run src/scripts/seedRecords.ts",
    "build": "pnpm generate:preview-styles && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8192\" next build --webpack",
    "postbuild": "next-sitemap --config ./next-sitemap.config.cjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "deploy:app": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "analyze": "ANALYZE=true next build --webpack",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "@docsearch/react": "^3.9.0",
    "@faceless-ui/collapsibles": "^2.0.0-beta.0",
    "@faceless-ui/css-grid": "1.3.0-rc.0",
    "@faceless-ui/modal": "3.0.2",
    "@faceless-ui/mouse-info": "2.0.0-beta.1",
    "@faceless-ui/scroll-info": "2.0.0",
    "@faceless-ui/slider": "2.0.0-beta.1",
    "@faceless-ui/window-info": "3.0.1",
    "@opennextjs/cloudflare": "1.20.16",
