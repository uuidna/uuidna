  "statement": "(List.range 32).all (fun hi => (List.range 32).all (fun lo => let m := hi * 32 + lo; let bit : Nat → Nat := fun i => m / 2 ^ i % 2; let tri := ([[0,1,4],[0,2,5],[0,3,6],[1,2,7],[1,3,8],[2,3,9],[4,5,7],[4,6,8],[5,6,9],[7,8,9]] : List (List Nat)).map (fun t => (t.map bit).foldl (fun a b => a * b) 1); let e := ((List.range 10).map bit).sum; (tri.sum != 0) || decide (e <= 6))) = true ∧ ((List.range 10).map (fun i => 126 / 2 ^ i % 2)).sum = 6 ∧ (([[0,1,4],[0,2,5],[0,3,6],[1,2,7],[1,3,8],[2,3,9],[4,5,7],[4,6,8],[5,6,9],[7,8,9]] : List (List Nat)).map (fun t => (t.map (fun i => 126 / 2 ^ i % 2)).foldl (fun a b => a * b) 1)).sum = 0",
