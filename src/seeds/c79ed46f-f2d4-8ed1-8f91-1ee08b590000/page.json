        {
          "type": "page",
          "slug": "theorem-budget_census_2d552f1f",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "The census the refutation recorded, decided: budget 4,5 on 18 rows, budget 5,4 on 30 rows, budget 6,3 on 6 rows; the mirror keeps the budget on 30 of the 54 rows; row (1, 3) is the first whose reflection moves it."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "famTally (fun a b => budget (arow a b) == (4, 5)) = 18 ∧ famTally (fun a b => budget (arow a b) == (5, 4)) = 30 ∧ famTally (fun a b => budget (arow a b) == (6, 3)) = 6 ∧ famTally (fun a b => budget ((arow a b).map dz) == budget (arow a b)) = 30 ∧ fallingOf (arow 1 3) = 4 ∧ fallingOf ((arow 1 3).map dz) = 5"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem budget_census_2d552f1f : famTally (fun a b => budget (arow a b) == (4, 5)) = 18 ∧ famTally (fun a b => budget (arow a b) == (5, 4)) = 30 ∧ famTally (fun a b => budget (arow a b) == (6, 3)) = 6 ∧ famTally (fun a b => budget ((arow a b).map dz) == budget (arow a b)) = 30 ∧ fallingOf (arow 1 3) = 4 ∧ fallingOf ((arow 1 3).map dz) = 5 := by decide"
                }
              ]
            }
