              "type": "text",
              "text": "{\n \"@context\": \"https://schema.org\",\n \"@type\": \"SoftwareSourceCode\",\n \"name\": \"Uuidna.lean\",\n \"url\": \"https://uuidna.com/lean/Uuidna.lean\",\n \"inLanguage\": \"lean4\",\n \"variableMeasured\": {\n  \"@type\": \"PropertyValue\",\n  \"name\": \"theorems\",\n  \"value\": 15,\n  \"unitText\": \"theorem\"\n }\n}"
