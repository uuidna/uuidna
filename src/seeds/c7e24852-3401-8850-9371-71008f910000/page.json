        {
          "type": "page",
          "slug": "theorem-a_floor_may_fall_to_what_is_anchored",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "17 − 2 = 15: a floor standing on two unearned anchors exceeds what it can defend"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(17 - 2 = 15) ∧ (17 - 1 = 16) ∧ (16 - 1 = 15) ∧ (17 > 15)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem a_floor_may_fall_to_what_is_anchored : (17 - 2 = 15) ∧ (17 - 1 = 16) ∧ (16 - 1 = 15) ∧ (17 > 15) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_two_sides_return_what_they_take",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "a fixed-point-free involution on two states: (1 + 1) % 2 = 0 and nothing is its own opposite"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "((1 + 1) % 2 = 0) ∧ (1 - 0 ≠ 0) ∧ (1 - 1 ≠ 1)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_two_sides_return_what_they_take : ((1 + 1) % 2 = 0) ∧ (1 - 0 ≠ 0) ∧ (1 - 1 ≠ 1) := by decide"
                }
              ]
            }
          ]
        },
        {
