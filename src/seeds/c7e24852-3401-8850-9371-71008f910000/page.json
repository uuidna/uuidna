              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem exponent_associativity_changes_the_value : (2^3^2 = 512) ∧ ((2^3)^2 = 64) ∧ (512 ≠ 64) := by decide"
