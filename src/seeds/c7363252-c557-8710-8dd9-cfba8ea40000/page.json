              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(reached.foldl (· + ·) 0 = 1) ∧ (12 > 10)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem one_probe_reached_the_planck_scale_and_found_nothing : (reached.foldl (· + ·) 0 = 1) ∧ (12 > 10) := by decide"
                }
              ]
            }
          ]
        },
