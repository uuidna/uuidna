              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "((43799 * 5 > 98707 * 2) ∧ (43799 * 2 < 98707)) ∧ (43799 < 98707)"
