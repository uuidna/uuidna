              "children": [
                {
                  "type": "text",
                  "text": "∀ (d : Bool) (n : Nat), altWalk d n 0 = 0"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem altWalk_zero : ∀ (d : Bool) (n : Nat), altWalk d n 0 = 0 := by intro d n induction n with | zero => rfl | succ n ih => show altStep d n (altWalk d n 0) = 0 rw [ih] unfold altStep cases (n % 2 == 0) == d <;> rfl"
                }
              ]
            }
          ]
        },
