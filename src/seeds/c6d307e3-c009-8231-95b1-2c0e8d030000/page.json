              "children": [
                {
                  "type": "text",
                  "text": "¬ (∀ s, s < 10 → ∃ dzFirst : Bool, ∀ t, t < 10 → ∃ n, altWalk dzFirst n s = t)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem alternation_misses_from_zero : ¬ (∀ s, s < 10 → ∃ dzFirst : Bool, ∀ t, t < 10 → ∃ n, altWalk dzFirst n s = t) := by exact fun h => match h 0 (by decide) with | ⟨d, hd⟩ => match hd 1 (by decide) with | ⟨n, hn⟩ => absurd ((altWalk_zero d n).symm.trans hn) (by decide)"
                }
              ]
            }
