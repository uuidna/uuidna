                  "text": "theorem de5612a2_go_congr : ∀ (y : Nat) (hy : 0 < y) (f₁ a : Nat) (h₁ : a < f₁) (f₂ b : Nat) (h₂ : b < f₂), a = b → Nat.modCore.go y hy f₁ a h₁ = Nat.modCore.go y hy f₂ b h₂ := by intro y hy f₁ a h₁ f₂ b h₂ hab subst hab exact de5612a2_go_fuel y hy f₁ a h₁ f₂ h₂"
