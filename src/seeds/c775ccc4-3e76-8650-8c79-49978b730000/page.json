                  "type": "text",
                  "text": "∀ (y : Nat) (hy : 0 < y) (f₁ x : Nat) (h₁ : x < f₁) (f₂ : Nat) (h₂ : x < f₂), Nat.modCore.go y hy f₁ x h₁ = Nat.modCore.go y hy f₂ x h₂"
