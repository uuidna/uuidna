            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem de5612a2_go_fuel : ∀ (y : Nat) (hy : 0 < y) (f₁ x : Nat) (h₁ : x < f₁) (f₂ : Nat) (h₂ : x < f₂), Nat.modCore.go y hy f₁ x h₁ = Nat.modCore.go y hy f₂ x h₂ := by intro y hy f₁ induction f₁ with | zero => intro x h₁; exact absurd h₁ (Nat.not_succ_le_zero x) | succ f ih => intro x h₁ f₂ h₂ cases f₂ with | zero => exact absurd h₂ (Nat.not_succ_le_zero x) | succ g => rw [Nat.modCore.go.eq_1, Nat.modCore.go.eq_1] by_cases h : y ≤ x · rw [dif_pos h, dif_pos h]; exact ih (x - y) _ g _ · rw [dif_neg h, dif_neg h]"
                }
              ]
            }
          ]
