        {
          "type": "page",
          "slug": "theorem-seam_census_c0727ef6",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "The census the refutation rests on: the tour has 2 seams and its dz-mirror has 9 — every step of the mirror is a seam, so no map can carry two onto nine."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(seamPairs tour).length = 2 ∧ (seamPairs (tour.map dz)).length = 9 ∧ (tour.map dz).length = 9"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem seam_census_c0727ef6 : (seamPairs tour).length = 2 ∧ (seamPairs (tour.map dz)).length = 9 ∧ (tour.map dz).length = 9 := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-involution_c0727ef6",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "The seams reflect (row1's seams map onto row2's under the mirror) — REFUTED: applying the tour's own law to the mirrored row gives 9 seams where the lead's image gives 2, so the seams do not reflect."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "¬ lead_c0727ef6"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem involution_c0727ef6 : ¬ lead_c0727ef6 := by unfold lead_c0727ef6; decide"
                }
              ]
            }
          ]
        }
