{
  "file": "UuidProgram.lean",
  "slug": "uuidprogram",
  "status": "usable",
  "address": "2523b05c-2494-8344-8526-77f9cda72fe0",
  "page": {
    "root": {
      "type": "root",
      "children": [
        {
          "type": "heading",
          "tag": "h1",
          "children": [
            {
              "type": "text",
              "text": "UuidProgram.lean — the sealed source"
            }
          ]
        },
        {
          "type": "code",
          "language": "json",
          "children": [
            {
              "type": "text",
              "text": "{\n \"@context\": \"https://schema.org\",\n \"@type\": \"SoftwareSourceCode\",\n \"name\": \"UuidProgram.lean\",\n \"url\": \"https://uuidna.com/lean/UuidProgram.lean\",\n \"inLanguage\": \"lean4\",\n \"variableMeasured\": {\n  \"@type\": \"PropertyValue\",\n  \"name\": \"theorems\",\n  \"value\": 8,\n  \"unitText\": \"theorem\"\n }\n}"
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_address",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "the program's UUID is a valid 32-digit address whose program field is uuidna_quantum's derived 8-hex program"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "quantumProgram.valid = true ∧ quantumProgram.program = [3, 9, 13, 11, 3, 10, 3, 0]"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_address : quantumProgram.valid = true ∧ quantumProgram.program = [3, 9, 13, 11, 3, 10, 3, 0] := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_layout",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "the address splits into handle · program · params · envelope and the four fields rejoin to the whole UUID"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "quantumProgram.handle ++ quantumProgram.program ++ quantumProgram.params ++ quantumProgram.envelope = quantumProgram.hex"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_layout : quantumProgram.handle ++ quantumProgram.program ++ quantumProgram.params ++ quantumProgram.envelope = quantumProgram.hex := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_h_unitary",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "Hadamard is unitary up to its scale: H · H† = 2 · I"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "Same 2 (mm 2 H (dag H)) (smul 2 idm)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_h_unitary : Same 2 (mm 2 H (dag H)) (smul 2 idm) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_paulis_unitary",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "X, Z and S are unitary, and S squared is Z"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "Same 2 (mm 2 X (dag X)) idm ∧ Same 2 (mm 2 Z (dag Z)) idm ∧ Same 2 (mm 2 S (dag S)) idm ∧ Same 2 (mm 2 S S) Z"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_paulis_unitary : Same 2 (mm 2 X (dag X)) idm ∧ Same 2 (mm 2 Z (dag Z)) idm ∧ Same 2 (mm 2 S (dag S)) idm ∧ Same 2 (mm 2 S S) Z := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_cnot_swap",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CNOT and SWAP are unitary and each is its own inverse"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "Same 4 (mm 4 CNOT (dag CNOT)) idm ∧ Same 4 (mm 4 CNOT CNOT) idm ∧ Same 4 (mm 4 SWAP (dag SWAP)) idm ∧ Same 4 (mm 4 SWAP SWAP) idm"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_cnot_swap : Same 4 (mm 4 CNOT (dag CNOT)) idm ∧ Same 4 (mm 4 CNOT CNOT) idm ∧ Same 4 (mm 4 SWAP (dag SWAP)) idm ∧ Same 4 (mm 4 SWAP SWAP) idm := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_toffoli",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "Toffoli is unitary and its own inverse"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "Same 8 (mm 8 TOFFOLI (dag TOFFOLI)) idm ∧ Same 8 (mm 8 TOFFOLI TOFFOLI) idm"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_toffoli : Same 8 (mm 8 TOFFOLI (dag TOFFOLI)) idm ∧ Same 8 (mm 8 TOFFOLI TOFFOLI) idm := by decide +kernel"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_bell_runs",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "the program at adb1b053-39db-3a30-0000-000000000000, run on the Bell circuit, puts weight on exactly 00 and 11, in equal shares — the weights its door serves"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(List.range 4).map (fun r => (bell r).normSq) = [1, 0, 0, 1]"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_bell_runs : (List.range 4).map (fun r => (bell r).normSq) = [1, 0, 0, 1] := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-uuidprog_ghz_runs",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "the program at adb1b053-39db-3a30-0000-000000000000, run on the GHZ circuit, puts weight on exactly 000 and 111, in equal shares — the weights its door serves"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(List.range 8).map (fun r => (ghz r).normSq) = [1, 0, 0, 0, 0, 0, 0, 1]"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem uuidprog_ghz_runs : (List.range 8).map (fun r => (ghz r).normSq) = [1, 0, 0, 0, 0, 0, 0, 1] := by decide +kernel"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
