        {
          "type": "page",
          "slug": "theorem-cms_events_close_over_their_files",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: each of four CMS datasets divides exactly, events = files·q + r with r below the file count. The integers are CERN's, credited; the arithmetic over them is this ledger's and is claimed."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(116 * 17922 + 54 = 2079006) ∧ (54 < 116) ∧ (184 * 12509 + 12 = 2301668) ∧ (12 < 184) ∧ (72 * 26572 + 6 = 1913190) ∧ (6 < 72) ∧ (130 * 21121 + 21 = 2745751) ∧ (21 < 130)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem cms_events_close_over_their_files : (116 * 17922 + 54 = 2079006) ∧ (54 < 116) ∧ (184 * 12509 + 12 = 2301668) ∧ (12 < 184) ∧ (72 * 26572 + 6 = 1913190) ∧ (6 < 72) ∧ (130 * 21121 + 21 = 2745751) ∧ (21 < 130) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_collision_energy_label_step_is_one_tev",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: the step from the 7TeV to the 8TeV label is exactly 1 TeV, 1000 GeV, 500 GeV per beam. That the accelerator reached those energies is CERN's claim, credited under its DOI."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(8 - 7 = 1) ∧ (8000 - 7000 = 1000) ∧ (7000 / 2 = 3500) ∧ (8000 / 2 = 4000) ∧ (4000 - 3500 = 500)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_collision_energy_label_step_is_one_tev : (8 - 7 = 1) ∧ (8000 - 7000 = 1000) ∧ (7000 / 2 = 3500) ∧ (8000 / 2 = 4000) ∧ (4000 - 3500 = 500) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_open_data_embargo_ran_six_years_or_longer",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: four records were published 6, 7, 7 and 8 years after their data was taken — every one at least six years."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(2019 - 2011 = 8) ∧ (2019 - 2012 = 7) ∧ (2017 - 2011 = 6) ∧ (8 ≥ 6) ∧ (7 ≥ 6) ∧ (6 ≥ 6)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_open_data_embargo_ran_six_years_or_longer : (2019 - 2011 = 8) ∧ (2019 - 2012 = 7) ∧ (2017 - 2011 = 6) ∧ (8 ≥ 6) ∧ (7 ≥ 6) ∧ (6 ≥ 6) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-these_two_eight_tev_datasets_hold_more_events_than_these_two_seven",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED for these four datasets: 5047419 events at the 8TeV label against 3992196 at 7TeV, summing to 9039615. Four datasets, not two runs — the scope is what was counted."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(2301668 + 2745751 = 5047419) ∧ (2079006 + 1913190 = 3992196) ∧ (5047419 > 3992196) ∧ (5047419 + 3992196 = 9039615)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem these_two_eight_tev_datasets_hold_more_events_than_these_two_seven : (2301668 + 2745751 = 5047419) ∧ (2079006 + 1913190 = 3992196) ∧ (5047419 > 3992196) ∧ (5047419 + 3992196 = 9039615) := by decide"
                }
              ]
            }
          ]
        },
