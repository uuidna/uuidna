            {
              "type": "text",
              "text": "{\n \"@context\": \"https://schema.org\",\n \"@type\": \"SoftwareSourceCode\",\n \"name\": \"Navigation.lean\",\n \"url\": \"https://uuidna.com/lean/Navigation.lean\",\n \"inLanguage\": \"lean4\",\n \"variableMeasured\": {\n  \"@type\": \"PropertyValue\",\n  \"name\": \"theorems\",\n  \"value\": 5,\n  \"unitText\": \"theorem\"\n }\n}"
            }
