          "children": [
            {
              "type": "text",
              "text": "{\n \"@context\": \"https://schema.org\",\n \"@type\": \"SoftwareSourceCode\",\n \"name\": \"Crypto.lean\",\n \"url\": \"https://uuidna.com/lean/Crypto.lean\",\n \"inLanguage\": \"lean4\",\n \"variableMeasured\": {\n  \"@type\": \"PropertyValue\",\n  \"name\": \"theorems\",\n  \"value\": 9,\n  \"unitText\": \"theorem\"\n }\n}"
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-three_sha2_digests_tile_the_sixtyfour_board_and_sha224_does_not",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: of the four SHA-2 digests this tree computes, 256, 384 and 512 bits tile the 64-bit board exactly — 4, 6 and 8 boards — and 224 alone does not, at three and a half."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(28 * 8 = 224) ∧ (32 * 8 = 256) ∧ (48 * 8 = 384) ∧ (64 * 8 = 512) ∧ (256 % 64 = 0) ∧ (384 % 64 = 0) ∧ (512 % 64 = 0) ∧ (224 % 64 = 32) ∧ (224 = 3 * 64 + 32)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem three_sha2_digests_tile_the_sixtyfour_board_and_sha224_does_not : (28 * 8 = 224) ∧ (32 * 8 = 256) ∧ (48 * 8 = 384) ∧ (64 * 8 = 512) ∧ (256 % 64 = 0) ∧ (384 % 64 = 0) ∧ (512 % 64 = 0) ∧ (224 % 64 = 32) ∧ (224 = 3 * 64 + 32) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-sha256_padding_closes_every_block_over_two_blocks_of_lengths",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED by enumeration over all 128 message lengths 0..127: the padded length is a multiple of 64 for every one, and the padding added is never fewer than 9 bytes nor more than 72."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(∀ l : Fin 128, (l.val + 9 + ((64 - ((l.val + 9) % 64)) % 64)) % 64 = 0 ∧ 9 ≤ (9 + ((64 - ((l.val + 9) % 64)) % 64)) ∧ (9 + ((64 - ((l.val + 9) % 64)) % 64)) ≤ 72)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem sha256_padding_closes_every_block_over_two_blocks_of_lengths : (∀ l : Fin 128, (l.val + 9 + ((64 - ((l.val + 9) % 64)) % 64)) % 64 = 0 ∧ 9 ≤ (9 + ((64 - ((l.val + 9) % 64)) % 64)) ∧ (9 + ((64 - ((l.val + 9) % 64)) % 64)) ≤ 72) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-sha512_doubles_the_word_block_and_digest_but_not_the_rounds",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: SHA-512 doubles SHA-256's word, block and digest exactly — 64 bits, 128 bytes, 64 bytes — and its round count does NOT double: 80, not 128, a difference of 16."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(64 = 2 * 32) ∧ (128 = 2 * 64) ∧ (1024 = 2 * 512) ∧ (80 ≠ 2 * 64) ∧ (80 - 64 = 16)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem sha512_doubles_the_word_block_and_digest_but_not_the_rounds : (64 = 2 * 32) ∧ (128 = 2 * 64) ∧ (1024 = 2 * 512) ∧ (80 ≠ 2 * 64) ∧ (80 - 64 = 16) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_chacha_state_partitions_into_constants_key_counter_and_nonce",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: ChaCha20's sixteen state words partition exactly as 4 constants + 8 key + 1 counter + 3 nonce; sixteen 32-bit words are 512 bits, which is the 64-byte block the implementation emits; twenty rounds are ten double-rounds; and the quarter-round rotations 16, 12, 8 and 7 sum to 43."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(4 + 8 + 1 + 3 = 16) ∧ (16 * 32 = 512) ∧ (512 / 8 = 64) ∧ (20 = 2 * 10) ∧ (16 + 12 + 8 + 7 = 43)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_chacha_state_partitions_into_constants_key_counter_and_nonce : (4 + 8 + 1 + 3 = 16) ∧ (16 * 32 = 512) ∧ (512 / 8 = 64) ∧ (20 = 2 * 10) ∧ (16 + 12 + 8 + 7 = 43) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_aead_envelope_fits_inside_one_chacha_block",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: key 32 + nonce 12 + tag 16 is 60 bytes — the whole AEAD envelope, strictly less than the 64-byte block with 4 bytes to spare — AND, by enumeration over all 64 plaintext lengths 0..63, the overhead is exactly 16 bytes at every one of them, so it does not grow with the message."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(32 + 12 + 16 = 60) ∧ (60 < 64) ∧ (64 - 60 = 4) ∧ (∀ n : Fin 64, n.val + 16 - n.val = 16)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_aead_envelope_fits_inside_one_chacha_block : (32 + 12 + 16 = 60) ∧ (60 < 64) ∧ (64 - 60 = 4) ∧ (∀ n : Fin 64, n.val + 16 - n.val = 16) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_hmac_pads_differ_in_the_bits_that_carry",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: HMAC's two pads 0x36 and 0x5c are 54 and 92, their difference is 38, and their exclusive-or is 106 — which is 0x6a, a byte with four bits set."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(54 = 32 + 16 + 4 + 2) ∧ (92 = 64 + 16 + 8 + 4) ∧ (16 + 4 = 20) ∧ (54 + 92 - 2 * 20 = 106) ∧ (106 = 64 + 32 + 8 + 2) ∧ (92 - 54 = 38)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_hmac_pads_differ_in_the_bits_that_carry : (54 = 32 + 16 + 4 + 2) ∧ (92 = 64 + 16 + 8 + 4) ∧ (16 + 4 = 20) ∧ (54 + 92 - 2 * 20 = 106) ∧ (106 = 64 + 32 + 8 + 2) ∧ (92 - 54 = 38) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-pbkdf2_block_count_is_the_ceiling_over_every_length_to_a_kilobit",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED by enumeration over all 129 derived-key lengths 0..128: the number of PBKDF2 blocks is the ceiling of the length over 32, and the blocks always cover the length without wasting a whole block."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(∀ d : Fin 129, ((d.val + 31) / 32) * 32 ≥ d.val ∧ (d.val = 0 ∨ (((d.val + 31) / 32) - 1) * 32 < d.val))"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem pbkdf2_block_count_is_the_ceiling_over_every_length_to_a_kilobit : (∀ d : Fin 129, ((d.val + 31) / 32) * 32 ≥ d.val ∧ (d.val = 0 ∨ (((d.val + 31) / 32) - 1) * 32 < d.val)) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-a_sha256_digest_is_two_uuids_and_four_boards_at_once",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED: a SHA-256 digest is 256 bits, which is exactly two 128-bit uuids, four 64-state boards, and sixty-four hexbits — the same quantity counted four ways, all whole."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(256 = 2 * 128) ∧ (256 = 4 * 64) ∧ (256 / 4 = 64) ∧ (32 * 8 = 256) ∧ (256 % 128 = 0) ∧ (256 % 64 = 0)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem a_sha256_digest_is_two_uuids_and_four_boards_at_once : (256 = 2 * 128) ∧ (256 = 4 * 64) ∧ (256 / 4 = 64) ∧ (32 * 8 = 256) ∧ (256 % 128 = 0) ∧ (256 % 64 = 0) := by decide"
                }
              ]
            }
          ]
        },
        {
          "type": "page",
          "slug": "theorem-the_claim_involution_fixes_only_the_honest_statement",
          "children": [
            {
              "type": "heading",
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "text": "CLAIMED by enumeration over all 25 balances from −12 to +12, carried on the mirror index i ↦ 24 − i: the claim involution applied twice returns every balance unchanged, it moves every balance except one, and the honest statement (balance 0, index 12) is its UNIQUE fixed point."
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "(∀ i : Fin 25, (24 - (24 - i.val) = i.val) ∧ (i.val = 12 ∨ 24 - i.val ≠ i.val)) ∧ (24 - 12 = 12)"
                }
              ]
            },
            {
              "type": "code",
              "language": "lean",
              "children": [
                {
                  "type": "text",
                  "text": "theorem the_claim_involution_fixes_only_the_honest_statement : (∀ i : Fin 25, (24 - (24 - i.val) = i.val) ∧ (i.val = 12 ∨ 24 - i.val ≠ i.val)) ∧ (24 - 12 = 12) := by decide"
                }
              ]
            }
          ]
        }
      ]
    }
  }
