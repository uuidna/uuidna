{
  "name": "@uuidna/uuidna",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Content-addressed identity, honest by construction — mint + mind, holographic merkle proofs, a reversible imprint codec, a reeducating harness, a measured billing model, pure-TypeScript ChaCha20-Poly1305 encryption under a 7d-fold envelope, and an MCP server to fuse it into any harness.",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "author": "Tsvetan Rouschev <ceccec@psg.bg>",
  "homepage": "https://github.com/uuidna/uuidna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/uuidna.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/uuidna/issues"
  },
  "keywords": [
    "uuid",
    "content-address",
    "merkle",
    "merkle-proof",
    "integrity",
    "fnv",
    "hash",
    "identity",
    "mcp",
    "model-context-protocol"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "uuidna-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "reserved.uuidna",
    "lean/axioms.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "site": "npm run docs:build",
    "docs:dev": "npm run build && vitepress dev",
    "docs:build": "npm run build && node dist/scripts/gen-mcp.js && node dist/scripts/gen-captain-claims.js && vitepress build && node dist/scripts/copy-lean-to-site.js",
    "gen:mcp": "npm run build && node dist/scripts/gen-mcp.js",
    "gen:captain-claims": "npm run build && node dist/scripts/gen-captain-claims.js",
    "seal:claims": "npm run build && node dist/scripts/seal-claims-audit.js",
    "audit:provenance": "npm run build && node dist/scripts/provenance.js",
    "audit:citations": "npm run build && node dist/scripts/audit-citations.js",
    "audit:packages": "npm run build && node dist/scripts/audit-packages.js",
    "quantum:scan": "npm run build && node dist/scripts/quantum-dimension-scan.js",
    "quantum:fold": "npm run build && node dist/scripts/fold-quantum.js",
    "gen:analytics": "npm run build && node dist/scripts/gen-analytics.js",
    "audit": "npm run lean && npm run build && node dist/scripts/gen-mcp.js && node dist/scripts/lean-axioms.js && node dist/scripts/provenance.js && node dist/scripts/support.js --check && node dist/scripts/audit-citations.js && node dist/scripts/account.js && node dist/scripts/security-audit.js && node dist/scripts/conformance.js && node dist/scripts/harmonic-scan.js && node dist/scripts/spin.js && node --test dist/test/*.test.js && node dist/scripts/gen-analytics.js && git diff --exit-code -- lean/ src/theorems/generated.ts lean/PRINCIPLE.md CHANGELOG.md audit-citations.json docs/mcp.md support-audit.json research-leads.json",
    "docs:preview": "vitepress preview",
    "lean": "npm run build && node dist/scripts/lean-all.js && node dist/scripts/sync-changelog.js",
    "lean:quantum": "node dist/scripts/lean-quantum.js",
    "lean:clay": "node dist/scripts/lean-clay.js",
    "lean:infinity": "node dist/scripts/lean-infinity.js",
    "lean:cipher": "node dist/scripts/lean-cipher.js",
    "lean:audit": "node dist/scripts/lean-audit.js",
    "lean:coins": "node dist/scripts/lean-coins.js",
    "lean:neuro": "node dist/scripts/lean-neuro.js",
    "lean:propulsion": "node dist/scripts/lean-propulsion.js",
    "lean:navigation": "node dist/scripts/lean-navigation.js",
    "lean:command": "node dist/scripts/lean-command.js",
    "lean:astronomy": "node dist/scripts/lean-astronomy.js",
    "lean:diving": "node dist/scripts/lean-diving.js",
    "lean:optics": "node dist/scripts/lean-optics.js",
    "lean:acoustics": "node dist/scripts/lean-acoustics.js",
    "lean:chemistry": "node dist/scripts/lean-chemistry.js",
    "lean:thermodynamics": "node dist/scripts/lean-thermodynamics.js",
    "lean:molecular": "node dist/scripts/lean-molecular.js",
    "lean:electromagnetism": "node dist/scripts/lean-electromagnetism.js",
    "lean:statics": "node dist/scripts/lean-statics.js",
    "lean:sailing": "node dist/scripts/lean-sailing.js",
    "lean:relativity": "node dist/scripts/lean-relativity.js",
    "lean:glagolitic": "node dist/scripts/lean-glagolitic.js",
    "lean:ephemeris": "node dist/scripts/lean-ephemeris.js",
    "lean:ledger": "node dist/scripts/lean-ledger.js",
    "lean:divzero": "node dist/scripts/lean-divzero.js",
    "lean:sequence": "node dist/scripts/lean-sequence.js",
    "mcp": "node dist/mcp.js",
    "daemon": "npm run build && node dist/daemon.js",
    "prepublishOnly": "npm run audit",
    "lean:biophysics": "node dist/scripts/lean-biophysics.js",
    "lean:discover": "node dist/scripts/lean-discover.js",
    "lean:core": "node dist/scripts/lean-core.js",
    "lean:tables": "node dist/scripts/lean-tables.js",
    "dev": "npm run build && vitepress dev",
    "preview": "vitepress preview",
    "heartbeats": "npm run build && node dist/scripts/lean-heartbeats.js",
    "axioms": "npm run build && node dist/scripts/lean-axioms.js",
    "axioms:hunt": "npm run build && node dist/scripts/axiom-hunt.js",
    "gen:seeds": "npm run build && node dist/scripts/lean-payload-seeds.js",
    "payload:sync": "npm run build && node dist/scripts/payload-sync.js",
    "account": "npm run build && node dist/scripts/account.js",
    "reconcile": "npm run build && node dist/scripts/reconcile.js",
    "spin": "npm run build && node dist/scripts/spin.js",
    "security": "npm run build && node dist/scripts/security-audit.js",
    "next": "npm run audit && node dist/scripts/next.js",
    "next:verify": "npm run build && node dist/scripts/spin.js --verify && npm run guard && node dist/scripts/next.js --verify",
    "hooks:install": "git config core.hooksPath hooks && echo \"git hooks installed (core.hooksPath=hooks): pre-push runs the readiness gate\"",
    "guard": "npm run build && node dist/scripts/guard.js",
    "gen:packages": "npm run build && node dist/scripts/gen-packages.js",
    "build:packages": "npm run build && npm run build --workspaces",
    "test:packages": "npm run build:packages && npm run test --workspaces",
    "crypto:measure": "npm run build && node dist/scripts/crypto-measure.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.19",
    "wrangler": "^4.121.0"
  }
}
