{
  "name": "@uuidna/uuidna",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Content-addressed identity, honest by construction — mint + mind, holographic merkle proofs, a reversible imprint codec, a reeducating harness, a measured billing model, pure-TypeScript ChaCha20-Poly1305 encryption under a 7d-fold envelope, and an MCP server to fuse it into any harness.",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "author": "Tsvetan Rouschev <ceccec@psg.bg>",
  "homepage": "https://github.com/uuidna/uuidna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/uuidna.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/uuidna/issues"
  },
  "keywords": [
    "uuid",
    "content-address",
    "merkle",
    "merkle-proof",
    "integrity",
    "fnv",
    "hash",
    "identity",
    "mcp",
    "model-context-protocol"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "uuidna-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "reserved.uuidna"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "site": "npm run docs:build",
    "docs:dev": "npm run build && vitepress dev",
    "docs:build": "npm run build && node dist/scripts/gen-mcp.js && vitepress build",
    "gen:mcp": "npm run build && node dist/scripts/gen-mcp.js",
    "audit:provenance": "npm run build && node dist/scripts/provenance.js",
    "audit": "npm run lean && npm run build && node dist/scripts/provenance.js && node dist/scripts/account.js && node --test dist/test/*.test.js && git diff --exit-code -- lean/ src/theorems/generated.ts lean/PRINCIPLE.md",
    "docs:preview": "vitepress preview",
    "lean": "npm run build && node dist/scripts/lean-all.js",
    "lean:quantum": "node dist/scripts/lean-quantum.js",
    "lean:clay": "node dist/scripts/lean-clay.js",
    "lean:infinity": "node dist/scripts/lean-infinity.js",
    "lean:cipher": "node dist/scripts/lean-cipher.js",
    "lean:audit": "node dist/scripts/lean-audit.js",
    "lean:coins": "node dist/scripts/lean-coins.js",
    "lean:neuro": "node dist/scripts/lean-neuro.js",
    "lean:propulsion": "node dist/scripts/lean-propulsion.js",
    "lean:navigation": "node dist/scripts/lean-navigation.js",
    "lean:command": "node dist/scripts/lean-command.js",
    "lean:astronomy": "node dist/scripts/lean-astronomy.js",
    "lean:diving": "node dist/scripts/lean-diving.js",
    "lean:optics": "node dist/scripts/lean-optics.js",
    "lean:acoustics": "node dist/scripts/lean-acoustics.js",
    "lean:chemistry": "node dist/scripts/lean-chemistry.js",
    "lean:thermodynamics": "node dist/scripts/lean-thermodynamics.js",
    "lean:molecular": "node dist/scripts/lean-molecular.js",
    "lean:electromagnetism": "node dist/scripts/lean-electromagnetism.js",
    "lean:statics": "node dist/scripts/lean-statics.js",
    "lean:sailing": "node dist/scripts/lean-sailing.js",
    "lean:relativity": "node dist/scripts/lean-relativity.js",
    "lean:glagolitic": "node dist/scripts/lean-glagolitic.js",
    "lean:ephemeris": "node dist/scripts/lean-ephemeris.js",
    "lean:ledger": "node dist/scripts/lean-ledger.js",
    "lean:divzero": "node dist/scripts/lean-divzero.js",
    "lean:sequence": "node dist/scripts/lean-sequence.js",
    "mcp": "node dist/mcp.js",
    "prepublishOnly": "npm run audit",
    "lean:biophysics": "node dist/scripts/lean-biophysics.js",
    "lean:discover": "node dist/scripts/lean-discover.js",
    "lean:core": "node dist/scripts/lean-core.js",
    "lean:tables": "node dist/scripts/lean-tables.js",
    "dev": "npm run build && vitepress dev",
    "preview": "vitepress preview",
    "heartbeats": "npm run build && node dist/scripts/lean-heartbeats.js",
    "account": "npm run build && node dist/scripts/account.js",
    "next": "npm run audit && node dist/scripts/next.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.19",
    "wrangler": "^4.121.0"
  }
}
