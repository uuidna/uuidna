#!/bin/sh
# pre-push — HARD. uuidnaOS hex image via MCP. No next, no VitePress, no tag-cut recompute.
if [ -n "$UUIDNA_OS_MCP" ]; then
  echo "pre-push: fused — uuidnaOS court already ran ($UUIDNA_OS_MCP)"
  exit 0
fi
if [ ! -f dist/quantum/os/cli.js ]; then
  echo "pre-push: HARD — dist/quantum/os/cli.js missing. Push BLOCKED."
  exit 1
fi
echo "pre-push: HARD — uuidnaOS (pure quantum hex; verify ≪ recompute)"
node dist/quantum/os/cli.js
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: uuidnaOS RED — push BLOCKED. derived drift: npm run reconcile -- --derive-only"
  exit $status
fi
echo "pre-push: ✓ uuidnaOS hex green."
exit 0
