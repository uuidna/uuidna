#!/bin/sh
# pre-push — the gate AT THE BOUNDARY. It runs the full readiness gate (npm run next); a non-zero exit BLOCKS the
# push, so a KNOWN denial — an overclaim the honesty gate drains, an unsealed proof, an unreconciled account, a
# next-gap, a stale changelog, a non-deterministic build — cannot cross to starboard (npm/deploy) undetected.
#
# HONEST SCOPE (integrity, not truth): this catches the gate's KNOWN forms only. It does NOT prove no denial can ever
# intrude: the gate's lexicon is incomplete (new forms appear and are hardened after), and a hook is bypassable with
# `git push --no-verify`. It RAISES the cost of intruding to a full gate pass; it does not close it to zero. A floor,
# not a maximum — the same honest bound the ledger proves in no_maximum_only_bounds.
# FAIL FAST FIRST. green runs the same denials in cheapest-first order — behind (~1s) and index (~1s) FIRST, then types, ledger, tests —
# plus two the full gate does not check at all: that origin holds nothing we lack, and that the index carries no
# other session's staged work. A failure here costs a second instead of four minutes, and the arms after the failing
# one are never run. `npm run next` still follows, because green defers the kernel.
echo "pre-push: green — cheapest-first denials before the full gate."
node dist/scripts/green.js
green=$?
if [ $green -ne 0 ]; then
  echo "pre-push: GREEN FAILED (exit $green) — push BLOCKED before the four-minute gate was spent."
  exit $green
fi

# THE RECEIPT IS WRITTEN WHERE IT WAS EARNED (lead 121a): green just proved tests and guard on exactly this
# tree, so the fingerprint is minted here and the full gate verifies it at O(1) instead of recomputing — one
# byte of drift between here and there fails --verify and the gate runs everything in full.
node dist/scripts/gate-receipt.js || echo "pre-push: the receipt could not be minted — the full gate will recompute in full (nothing hidden, nothing skipped)"

echo "pre-push: running the readiness gate (npm run next) — a failing gate blocks the push."
npm run next
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: GATE FAILED (exit $status) — push BLOCKED. Fix the denial, or bypass knowingly with --no-verify (owned, not hidden)."
  echo "pre-push: MOST failures after adding theorems are a STALE DERIVED LAYER (a git-diff of generated.ts / PRINCIPLE.md / heartbeats.json / docs/mcp.md / audit-citations.json). The fix on a SHARED tree is:  npm run reconcile -- --derive-only  — it regenerates, syncs the heartbeats and re-seals, and publishes NOTHING. Plain `npm run reconcile` does the same then stages, commits and pushes, and it stages DRAIN_PATHS as DIRECTORIES — on a checkout several sessions share that sweeps somebody else's untracked files into your commit. A genuine overclaim or unsealed proof must be fixed at the source instead."
fi
exit $status
