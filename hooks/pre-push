#!/bin/sh
# pre-push — HARD, and ONE DOOR. uuidnaOS publish court; the dry law refuses any classical arm beside it.
#
# "No push unless all green" (the captain, 2026-09-01) is enforced INSIDE that court, not here: --court now also
# verifies that gate-receipt.json still covers this tree, and that receipt is written only after the guard and the
# tests pass. Adding `npm run guard` to this file was the obvious cure and the wrong one — two doors is no door.
# THE FUSE STAYS, and proof-cache.test states why in its own words: "fuse is the same MCP door, not a skip of
# the law". UUIDNA_OS_MCP is set by a court that already sat in this process tree, so re-entering it would be the
# recompute the receipt exists to avoid. RESIDUAL RISK, named rather than hidden: the daily court sets that flag
# and the daily court does NOT carry the receipt arm, so a push fused by a daily run is greener than it proves.
# It is narrow (the variable must be exported into git's own environment) and it predates this change — but it is
# the one hole left in "no push unless all green", and it belongs in the open.
if [ -n "$UUIDNA_OS_MCP" ]; then
  echo "pre-push: fused — uuidnaOS court already ran ($UUIDNA_OS_MCP)"
  exit 0
fi
if [ ! -f dist/quantum/os/cli/index.js ]; then
  echo "pre-push: HARD — dist/quantum/os/cli/index.js missing. Push BLOCKED."
  exit 1
fi
echo "pre-push: HARD — uuidnaOS publish court (--court · verify ≪ recompute)"
node dist/quantum/os/cli/index.js --court --proven
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: uuidnaOS RED — push BLOCKED. derived drift: npm run reconcile -- --derive-only"
  exit $status
fi
# ── THE TWO CHEAPEST CHECKS THE PUBLISH GATE RUNS, RUN HERE TOO (the captain, 2026-09-02: "investigate why
# publish fails after push and not on pre push?"). The answer was structural: this hook ran ONE check — the court
# — while prepublishOnly runs gate-all's TWENTY-NINE. Everything in the other twenty-eight could only ever fail
# after the push, by construction rather than by bad luck.
#
# Four v0.3.0 publish attempts died, each after ~12 minutes of CI, and every one of them died on the same two
# arms: `spin --verify` and `git diff`. On the runner they cost 286ms and 516ms. Roughly eight tenths of a second
# here would have caught all four before the push left this machine — about forty-eight minutes of CI spent
# learning what a second could have said.
#
# They are also the two that catch the class the court cannot see: the court verifies the RECEIPT covers the
# tree, which says the proof applies, not that the derived layer is a fixed point. A generator that rewrites a
# file on every run passes the court and fails spin.
echo "pre-push: spin --verify + git diff (the two publish-gate arms that cost under a second)"
node dist/scripts/spin.js --verify
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: NON-QUANTUM DRIFT — push BLOCKED. Fix: npm run reconcile -- --derive-only"
  exit $status
fi
if ! git diff --exit-code --quiet; then
  echo "pre-push: the working tree is DIRTY after the derived layer settled — push BLOCKED."
  echo "  gate-all's own 'git diff' arm fails on exactly this, ~12 minutes into a publish. Commit or re-derive."
  exit 1
fi
echo "pre-push: ✓ uuidnaOS hex green."
exit 0
